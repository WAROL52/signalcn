{
  "name": "signalcn",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Moteur de signaux réactifs agnostique des frameworks, distribué comme code source.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "biome": "biome ci",
    "formater": "biome format --write && biome check --write --only=assist/source/organizeImports",
    "test": "node --test --test-reporter=tap registry/default/signals.test.ts",
    "harnais": "node scripts/harnais.mjs",
    "couverture": "node scripts/porte-couverture.mjs",
    "zero-dependance": "node scripts/zero-dependance.mjs",
    "build": "node scripts/build.mjs",
    "verifier-build": "node scripts/verifier-build.mjs",
    "parite": "node scripts/verifier-parite.mjs",
    "documentation": "node scripts/verifier-documentation.mjs",
    "verifier-derive": "node scripts/verifier-derive.mjs",
    "documentation-statique": "vitepress build site",
    "verifier-proprete": "node scripts/verifier-proprete.mjs",
    "verifier-installation": "node scripts/verifier-installation.mjs",
    "verifier-ruleset": "node scripts/verifier-ruleset.mjs",
    "porte": "npm run typecheck && npm run harnais && npm run couverture && npm run test && npm run biome && npm run build && npm run zero-dependance && npm run verifier-build && npm run parite && npm run documentation && npm run verifier-derive && npm run documentation-statique && npm run verifier-proprete && npm run verifier-ruleset",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@preact/signals-core": "1.14.4",
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "lefthook": "2.1.16",
    "shadcn": "2.10.0",
    "typescript": "5.9.2",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=22.6"
  }
}
